# ============================================================
#  BVTech OpsPilot — environment configuration
#  Copy to ".env" and fill in. NEVER commit the real .env.
# ============================================================

ENV=production                # development | production

# --- Secrets (generate fresh, unique values) ---
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_64_BYTES
AGENT_ENROLL_SECRET=CHANGE_ME_DIFFERENT_64_BYTES

# --- Database / cache ---
DATABASE_URL=postgresql+psycopg://pulse:CHANGE_ME@db:5432/pulse
REDIS_URL=redis://redis:6379/0

# --- Sessions ---
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=true            # MUST be true in production (HTTPS only)
# COOKIE_DOMAIN=opspilot.bvtech.org

# --- First-run bootstrap owner (rotate the password after first login) ---
BOOTSTRAP_ADMIN_EMAIL=admin@bvtech.org
# Leave password blank to have a random one printed once in the logs:
BOOTSTRAP_ADMIN_PASSWORD=

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MIN=5

# --- Postgres container creds (used by docker-compose) ---
POSTGRES_USER=pulse
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pulse
