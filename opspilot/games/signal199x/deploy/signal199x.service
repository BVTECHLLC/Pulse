[Unit]
Description=Signal 199X - authoritative 3D retro-tech MMO alpha server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=signal199x
Group=signal199x
WorkingDirectory=/opt/signal-199x
ExecStart=/usr/bin/node /opt/signal-199x/server.mjs
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=DATA_DIR=/var/lib/signal199x
Environment=TRUST_PROXY=true
Environment=ENABLE_TEXT_CHAT=false
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/signal199x
RestrictSUIDSGID=true
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
