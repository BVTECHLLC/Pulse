# ============================================================
#  BVTech OpsPilot — environment configuration
#  Copy to ".env" and fill in. NEVER commit the real .env.
# ============================================================

ENV=production                # development | production

# --- Secrets (generate fresh, unique values) ---
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_64_BYTES
AGENT_ENROLL_SECRET=CHANGE_ME_DIFFERENT_64_BYTES

# --- Database / cache ---
DATABASE_URL=postgresql+psycopg://pulse:CHANGE_ME@db:5432/pulse
REDIS_URL=redis://redis:6379/0

# --- Sessions ---
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=true            # MUST be true in production (HTTPS only)
# COOKIE_DOMAIN=opspilot.bvtech.org

# --- First-run bootstrap owner (rotate the password after first login) ---
BOOTSTRAP_ADMIN_EMAIL=help@bvtech.org
# Leave password blank to have a random one printed once in the logs:
BOOTSTRAP_ADMIN_PASSWORD=

# --- Branding / public URLs ---
SUPPORT_EMAIL=help@bvtech.org
PUBLIC_BASE_URL=https://portal.bvtech.org

# --- Outbound email (SMTP). Leave SMTP_HOST blank to disable sending (safe no-op).
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=help@bvtech.org
# SMTP_PASSWORD=your-smtp-app-password
# SMTP_FROM=help@bvtech.org
# SMTP_STARTTLS=true
SMTP_HOST=

# --- Microsoft 365 (Graph) — one Entra app, read-only, multi-tenant.
#     Leave blank to disable; live sync returns 503 until these are set.
#     Required Graph application permissions (admin-consented per customer tenant):
#       Organization.Read.All, Directory.Read.All, SecurityEvents.Read.All,
#       IdentityRiskyUser.Read.All
# M365_CLIENT_ID=00000000-0000-0000-0000-000000000000
# M365_CLIENT_SECRET=your-entra-app-secret
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_SIGNUP_PER_MIN=3

# --- Postgres container creds (used by docker-compose) ---
POSTGRES_USER=pulse
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pulse

# --- AI (Claude) — powers Ask Pulse, ticket auto-triage, AI post writing,
#     alert explanations, and monthly Academy quiz refresh. Without it, all AI
#     features show a clear "connect Claude" message instead of failing. ---
ANTHROPIC_API_KEY=

# --- Autopilot (in-process scheduler; on by default). Set 0 to disable. ---
# SCHEDULER_ENABLED=1

# ============================================================
#  Optional: integration credentials via environment
#  Everything below can ALSO be configured in Settings (encrypted vault).
#  Any value set here overwrites the vault on boot (env wins).
# ============================================================
# Microsoft 365 mailbox app (Graph):    M365_CLIENT_ID / M365_CLIENT_SECRET /
#                                       M365_TENANT_ID / M365_MAILBOX
# Microsoft SSO sign-in app (separate app with the redirect URI registered!):
#                                       M365_SSO_CLIENT_ID / M365_SSO_CLIENT_SECRET
# Google sign-in:                       GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# Google Business Profile:              GBP_CLIENT_ID / GBP_CLIENT_SECRET /
#                                       GBP_REFRESH_TOKEN / GBP_ACCOUNT_NAME / GBP_LOCATION_NAME
# LinkedIn publishing:                  LINKEDIN_CLIENT_ID / LINKEDIN_CLIENT_SECRET /
#                                       LINKEDIN_ACCESS_TOKEN / LINKEDIN_PERSON_URN
# Stripe:                               STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
# QuickBooks:                           QUICKBOOKS_CLIENT_ID / _SECRET / _REFRESH_TOKEN / _REALM_ID
# HubSpot:                              HUBSPOT_TOKEN
# Tactical RMM:                         TACTICAL_BASE_URL / TACTICAL_API_KEY
# Dialpad:                              DIALPAD_API_KEY / DIALPAD_USER_ID / DIALPAD_CALLER_NUMBER
# Google Places (prospecting):          GOOGLE_PLACES_API_KEY
# Payment handles:                      PAYPAL_HANDLE / VENMO_HANDLE / CASHAPP_CASHTAG
